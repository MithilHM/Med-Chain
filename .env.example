# ==============================================================================
# MedChain Environment Configuration
# Copy this file to .env and adjust variables as required for local development.
# ==============================================================================

# Application & API
ENVIRONMENT=development
DEMO_MODE=true
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=medchain-development-secret-key-32-bytes-long-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL (Authoritative Relational Store)
POSTGRES_USER=medchain_user
POSTGRES_PASSWORD=medchain_secret_pass
POSTGRES_DB=medchain_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://medchain_user:medchain_secret_pass@localhost:5432/medchain_db
DATABASE_SYNC_URL=postgresql://medchain_user:medchain_secret_pass@localhost:5432/medchain_db
# Fallback SQLite for local dev when PostgreSQL container is not started:
FALLBACK_SQLITE_URL=sqlite+aiosqlite:///./medchain_local.db
FALLBACK_SQLITE_SYNC_URL=sqlite:///./medchain_local.db

# MongoDB (Semi-Structured Documents)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=medchain_docs
MONGO_DOCUMENTS_COLLECTION=medical_documents

# Neo4j (Derived Graph Intelligence)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medchain_graph_pass

# Blockchain (Hardhat EVM Local Node)
BLOCKCHAIN_RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_CHAIN_ID=31337

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
